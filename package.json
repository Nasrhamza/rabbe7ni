{
  "name": "rabbehni",
  "version": "0.0.0",
  "private": true,
  "description": "Rabbehni intelligent and culturally adaptive loyalty platform",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "nx run-many --target=build --all --parallel=3",
    "clean": "rimraf dist .nx/cache coverage",
    "dev": "nx run-many --target=dev --projects=admin-web,merchant-web,api,analytics-service,notification-worker --parallel=5",
    "dev:mobile": "nx dev customer-mobile",
    "dev:ai": "nx dev ai-service",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many --target=lint --all --parallel=3",
    "test": "nx run-many --target=test --all --parallel=3",
    "typecheck": "nx run-many --target=typecheck --all --parallel=3",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "validate:static": "node tools/validate-foundation.mjs",
    "graph": "nx graph",
    "db:generate": "pnpm --filter @rabbehni/database generate",
    "db:validate": "pnpm --filter @rabbehni/database validate",
    "db:migrate:dev": "pnpm --filter @rabbehni/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @rabbehni/database migrate:deploy",
    "db:seed": "pnpm --filter @rabbehni/database seed",
    "infra:config": "docker compose --env-file .env -f infra/docker/compose.yaml --profile identity --profile analytics --profile observability --profile applications config",
    "infra:up": "docker compose --env-file .env -f infra/docker/compose.yaml --profile identity --profile analytics --profile observability --profile applications up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "nx": "23.3.0",
    "prettier": "3.9.9",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "bootstrap": "5.3.8"
  }
}
