NODE_ENV=development
LOG_LEVEL=info
SERVICE_VERSION=0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Public endpoints
ADMIN_WEB_PORT=3001
MERCHANT_WEB_PORT=3002
API_PORT=4000
AI_PORT=8000
ANALYTICS_PORT=4100
NOTIFICATION_WORKER_PORT=4101
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL / Prisma
POSTGRES_USER=rabbehni
POSTGRES_PASSWORD=rabbehni_dev_only
POSTGRES_APP_USER=rabbehni_app
POSTGRES_APP_PASSWORD=rabbehni_app_dev_only
POSTGRES_DB=rabbehni
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rabbehni_app:rabbehni_app_dev_only@localhost:5432/rabbehni?schema=public
DIRECT_DATABASE_URL=postgresql://rabbehni:rabbehni_dev_only@localhost:5432/rabbehni?schema=public
TEST_DATABASE_URL=postgresql://rabbehni_app:rabbehni_app_dev_only@localhost:5432/rabbehni?schema=public

# Redis and eventing
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_only
REDIS_URL=redis://:redis_dev_only@localhost:6379
BULLMQ_PREFIX=rabbehni
NATS_PORT=4222
NATS_MONITORING_PORT=8222
NATS_USER=rabbehni
NATS_PASSWORD=nats_dev_only
NATS_URL=nats://rabbehni:nats_dev_only@localhost:4222

# Keycloak / OIDC
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rabbehni
MAILPIT_IMAGE=axllent/mailpit:v1.30.0
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
OIDC_ISSUER_URL=http://localhost:8080/realms/rabbehni
OIDC_BACKCHANNEL_URL=http://localhost:8080/realms/rabbehni
OIDC_CLIENT_ID=rabbehni-web
OIDC_AUDIENCE=rabbehni-api
OIDC_CALLBACK_URL=http://localhost:4000/v1/auth/callback
OIDC_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback,http://localhost:3001/auth/callback,http://localhost:3002/auth/callback
KEYCLOAK_ADMIN_CLIENT_ID=rabbehni-auth-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=rabbehni_auth_admin_dev_secret
CUSTOMER_SIGNUP_TENANT_ID=10000000-0000-4000-8000-000000000001
CUSTOMER_SIGNUP_ORGANIZATION_ID=10000000-0000-4000-8000-000000000002
SESSION_COOKIE_NAME=rabbehni_session
SESSION_SIGNING_SECRET=rabbehni_dev_signing_secret_change_me_2026
SESSION_ENCRYPTION_KEY=rabbehni_dev_encryption_secret_change_me_2026
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false
NEXT_PUBLIC_OIDC_ISSUER_URL=http://localhost:8080/realms/rabbehni
NEXT_PUBLIC_OIDC_MOBILE_CLIENT_ID=rabbehni-mobile
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_OIDC_ISSUER_URL=http://10.0.2.2:8080/realms/rabbehni
EXPO_PUBLIC_OIDC_CLIENT_ID=rabbehni-mobile
EXPO_PUBLIC_PASSWORD_LOGIN=false

# Analytics
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=rabbehni
CLICKHOUSE_PASSWORD=rabbehni_dev_only
CLICKHOUSE_DATABASE=rabbehni_analytics
CLICKHOUSE_URL=http://localhost:8123
ANALYTICS_SERVICE_URL=http://localhost:4100
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=rabbehni-local-internal-token
PFE_SANDBOX_WEBHOOK_SECRET=rabbehni-pfe-sandbox-webhook-secret

# Object storage
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
MINIO_ROOT_USER=rabbehni
MINIO_ROOT_PASSWORD=rabbehni_dev_only
S3_ENDPOINT=http://localhost:9001
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=rabbehni
S3_SECRET_ACCESS_KEY=rabbehni_dev_only
S3_BUCKET_ASSETS=rabbehni-assets
S3_BUCKET_REPORTS=rabbehni-reports
S3_BUCKET_MODELS=rabbehni-models

# OpenTelemetry and observability
OTEL_SERVICE_NAME=rabbehni-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_only
LOKI_PORT=3100
TEMPO_PORT=3200
