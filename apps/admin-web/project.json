{
  "name": "admin-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin-web/src",
  "tags": ["scope:admin-web", "type:application"],
  "targets": {
    "build": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/admin-web build"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/admin-web dev"
      },
      "cache": false,
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/admin-web lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/admin-web test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/admin-web typecheck"
      }
    }
  }
}
