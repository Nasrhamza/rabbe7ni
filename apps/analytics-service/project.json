{
  "name": "analytics-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/analytics-service/src",
  "tags": ["scope:analytics", "type:application"],
  "implicitDependencies": [
    "config",
    "contracts",
    "database",
    "logger",
    "nestjs-platform",
    "observability"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm --filter @rabbehni/analytics-service build"
      },
      "outputs": ["{workspaceRoot}/dist/apps/analytics-service"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/analytics-service dev"
      },
      "cache": false,
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/analytics-service lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/analytics-service test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/analytics-service typecheck"
      }
    }
  }
}
