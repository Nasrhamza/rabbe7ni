{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:backend", "type:application"],
  "implicitDependencies": [
    "cache",
    "config",
    "contracts",
    "database",
    "logger",
    "nestjs-platform",
    "observability",
    "queue"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm --filter @rabbehni/api build"
      },
      "outputs": ["{workspaceRoot}/dist/apps/api"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/api dev"
      },
      "cache": false,
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/api lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/api test"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/api"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @rabbehni/api typecheck"
      }
    }
  }
}
