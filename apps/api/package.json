    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@nestjs/terminus": "12.1.0",
    "@rabbehni/cache": "workspace:*",
    "@rabbehni/config": "workspace:*",
    "@rabbehni/contracts": "workspace:*",
    "@rabbehni/database": "workspace:*",
    "@rabbehni/logger": "workspace:*",
    "@rabbehni/nestjs-platform": "workspace:*",
    "@rabbehni/observability": "workspace:*",
    "@rabbehni/queue": "workspace:*",
    "bullmq": "6.4.0",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0"
