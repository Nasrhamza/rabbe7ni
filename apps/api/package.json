{
  "name": "@rabbehni/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json --env-file=../../.env src/main.ts",
    "lint": "eslint src tests",
    "start": "node ../../dist/apps/api/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
