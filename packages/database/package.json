{
  "name": "@rabbehni/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate --config prisma.config.ts",
    "lint": "eslint src prisma/*.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "validate": "prisma validate --config prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "dotenv": "18.0.8",
    "prisma": "7.10.1"
  }
}
