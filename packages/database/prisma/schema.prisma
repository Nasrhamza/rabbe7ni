  annualPriceMinor          Int                      @default(0) @map("annual_price_minor")
  transactionFeeBasisPoints Int                      @default(0) @map("transaction_fee_basis_points")
  trialDays                 Int                      @default(14) @map("trial_days")
  sortOrder                 Int                      @default(0) @map("sort_order")
  entitlements              Json
  limits                    Json
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions             Subscription[]
  featureEntitlements       PlanFeatureEntitlement[]
  quotaLimits               PlanQuotaLimit[]

  @@index([status, sortOrder])
  @@map("plans")
}

model Subscription {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  planId                String               @map("plan_id") @db.Uuid
  status                SubscriptionStatus   @default(TRIALING)
  billingInterval       BillingInterval      @default(MONTHLY) @map("billing_interval")
  startsAt              DateTime             @map("starts_at") @db.Timestamptz(3)
  trialEndsAt           DateTime?            @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStartsAt DateTime?            @map("current_period_starts_at") @db.Timestamptz(3)
  currentPeriodEndsAt   DateTime?            @map("current_period_ends_at") @db.Timestamptz(3)
  nextBillingAt         DateTime?            @map("next_billing_at") @db.Timestamptz(3)
  cancelAtPeriodEnd     Boolean              @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime?            @map("canceled_at") @db.Timestamptz(3)
  suspendedAt           DateTime?            @map("suspended_at") @db.Timestamptz(3)
  endedAt               DateTime?            @map("ended_at") @db.Timestamptz(3)
  version               Int                  @default(1)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                  Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  changes               SubscriptionChange[]
  paymentIntents        PaymentIntent[]
  payments              PaymentTransaction[]
  invoices              Invoice[]
  usageRecords          UsageRecord[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([planId])
  @@index([tenantId, startsAt])
  @@map("subscriptions")
}

model PlanFeatureEntitlement {
  id            String   @id @default(uuid()) @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  featureKey    String   @map("feature_key")
  enabled       Boolean  @default(true)
  configuration Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  plan          Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey, enabled])
  @@map("plan_feature_entitlements")
}

model PlanQuotaLimit {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  metricKey  String   @map("metric_key")
  limitValue Int      @map("limit_value")
  period     String   @default("MONTH")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metricKey])
  @@map("plan_quota_limits")
}

model SubscriptionChange {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  subscriptionId String                 @map("subscription_id") @db.Uuid
  idempotencyKey String                 @map("idempotency_key")
  type           SubscriptionChangeType
  fromPlanId     String?                @map("from_plan_id") @db.Uuid
  toPlanId       String?                @map("to_plan_id") @db.Uuid
  reason         String?
  metadata       Json                   @default("{}")
  effectiveAt    DateTime               @default(now()) @map("effective_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription           @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, subscriptionId, effectiveAt(sort: Desc)])
  @@map("subscription_changes")
}

model PaymentIntent {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  subscriptionId    String               @map("subscription_id") @db.Uuid
  idempotencyKey    String               @map("idempotency_key")
  checkoutTokenHash String               @unique @map("checkout_token_hash") @db.Char(64)
  amountMinor       Int                  @map("amount_minor")
  currency          String               @db.Char(3)
  status            PaymentStatus        @default(PENDING)
  provider          String               @default("PFE_SANDBOX")
  failureCode       String?              @map("failure_code")
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(3)
  confirmedAt       DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription      Subscription         @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  payments          PaymentTransaction[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("payment_intents")
}

model Invoice {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  subscriptionId String               @map("subscription_id") @db.Uuid
  number         String
  status         InvoiceStatus        @default(OPEN)
  currency       String               @db.Char(3)
  subtotalMinor  Int                  @map("subtotal_minor")
  feeMinor       Int                  @default(0) @map("fee_minor")
  taxMinor       Int                  @default(0) @map("tax_minor")
  totalMinor     Int                  @map("total_minor")
  lineItems      Json                 @default("[]") @map("line_items")
  periodStart    DateTime             @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime             @map("period_end") @db.Timestamptz(3)
  dueAt          DateTime             @map("due_at") @db.Timestamptz(3)
  paidAt         DateTime?            @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   Subscription         @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payments       PaymentTransaction[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("invoices")
}

model PaymentTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  subscriptionId  String        @map("subscription_id") @db.Uuid
  paymentIntentId String        @map("payment_intent_id") @db.Uuid
  invoiceId       String?       @map("invoice_id") @db.Uuid
  idempotencyKey  String        @map("idempotency_key")
  status          PaymentStatus
  amountMinor     Int           @map("amount_minor")
  feeMinor        Int           @default(0) @map("fee_minor")
  currency        String        @db.Char(3)
  providerRef     String        @map("provider_ref")
  failureCode     String?       @map("failure_code")
  failureMessage  String?       @map("failure_message")
  processedAt     DateTime      @default(now()) @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    Subscription  @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  invoice         Invoice?      @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, processedAt(sort: Desc)])
  @@index([paymentIntentId, tenantId])
  @@map("payment_transactions")
}

model BillingWebhook {
