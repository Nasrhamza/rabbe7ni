  @@unique([id, tenantId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
  @@index([correlationId])
  @@map("audit_logs")
}

model OutboxEvent {
