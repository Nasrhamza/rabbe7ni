model User {
  id                  String                @id @default(uuid()) @db.Uuid
  externalSubject     String?               @unique @map("external_subject")
  email               String
  normalizedEmail     String                @unique @map("normalized_email")
  displayName         String                @map("display_name")
  locale              String                @default("en")
  status              UserStatus            @default(INVITED)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deactivatedAt       DateTime?             @map("deactivated_at") @db.Timestamptz(3)
  memberships         Membership[]
  staffProfiles       Staff[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  updatedSettings     TenantSetting[]       @relation("TenantSettingUpdater")
  authSessions        AuthSession[]
  customers           Customer[]
  pointsEntries       PointsLedgerEntry[]   @relation("PointsEntryActor")
  xpEntries           XpLedgerEntry[]       @relation("XpEntryActor")
  revokedBadges       CustomerBadge[]       @relation("BadgeRevoker")
  regionalAssignments RegionAdministrator[]

  @@index([status])
  @@map("users")
}

model Tenant {
  id                             String                            @id @default(uuid()) @db.Uuid
  slug                           String                            @unique
  status                         TenantStatus                      @default(PROVISIONING)
  region                         String
  defaultLocale                  String                            @default("en") @map("default_locale")
  defaultCurrency                String                            @default("TND") @map("default_currency") @db.Char(3)
  createdAt                      DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizations                  Organization[]
  franchises                     Franchise[]
  merchants                      Merchant[]
  branches                       Branch[]
  memberships                    Membership[]
  staff                          Staff[]
  roles                          Role[]
  rolePermissions                RolePermission[]
  membershipRoles                MembershipRole[]
  subscriptions                  Subscription[]
  subscriptionChanges            SubscriptionChange[]
  paymentIntents                 PaymentIntent[]
  paymentTransactions            PaymentTransaction[]
  invoices                       Invoice[]
  billingWebhooks                BillingWebhook[]
  usageRecords                   UsageRecord[]
  quotaOverrides                 TenantQuotaOverride[]
  whiteLabelProfile              WhiteLabelProfile?
  localizationProfile            TenantLocalization?
  customDomains                  CustomDomain[]
  settings                       TenantSetting[]
  auditLogs                      AuditLog[]
  outboxEvents                   OutboxEvent[]
  authSessions                   AuthSession[]
  customers                      Customer[]
  customerActivities             CustomerActivity[]
  loyaltyPrograms                LoyaltyProgram[]
  earningRules                   EarningRule[]
  redemptionRules                RedemptionRule[]
  programMerchants               ProgramMerchant[]
  programBranches                ProgramBranch[]
  pointsEntries                  PointsLedgerEntry[]
  rewardCategories               RewardCategory[]
  rewards                        Reward[]
  rewardMerchants                RewardMerchant[]
  rewardBranches                 RewardBranch[]
  rewardRedemptions              RewardRedemption[]
  qrTokens                       CustomerQrToken[]
  qrTransactions                 QrTransaction[]
  gamificationConfig             GamificationConfig?
  xpRules                        XpRule[]
  levels                         LevelDefinition[]
  gamificationProfiles           CustomerGamificationProfile[]
  xpEntries                      XpLedgerEntry[]
  levelHistory                   CustomerLevelHistory[]
  challenges                     Challenge[]
  challengeScopes                ChallengeApplicability[]
  challengeEnrollments           ChallengeEnrollment[]
  challengeProgress              ChallengeProgressEvent[]
  challengeRewards               ChallengeReward[]
  challengeGrants                ChallengeRewardGrant[]
  habits                         Habit[]
  customerHabits                 CustomerHabit[]
  habitCompletions               HabitCompletion[]
  habitMilestones                HabitMilestone[]
  streakRules                    StreakRule[]
  customerStreaks                CustomerStreak[]
  streakHistory                  StreakHistory[]
  badgeCategories                BadgeCategory[]
  badges                         Badge[]
  achievementRules               AchievementRule[]
  achievementProgress            AchievementProgress[]
  customerBadges                 CustomerBadge[]
  leaderboardConfigs             LeaderboardConfig[]
  leaderboardSnapshots           LeaderboardSnapshot[]
  leaderboardEntries             LeaderboardEntry[]
  gamificationEvents             GamificationEventReceipt[]
  customerSegments               CustomerSegment[]
  segmentMemberships             SegmentMembership[]
  segmentHistory                 SegmentMembershipHistory[]
  campaigns                      Campaign[]
  campaignSegments               CampaignSegment[]
  campaignScopes                 CampaignApplicability[]
  automationWorkflows            AutomationWorkflow[]
  automationSteps                AutomationStep[]
  automationExecutions           AutomationExecution[]
  automationStepRuns             AutomationStepExecution[]
  notificationTemplates          NotificationTemplate[]
  templateVersions               NotificationTemplateVersion[]
  notificationDeliveries         NotificationDelivery[]
  notificationAttempts           NotificationAttempt[]
  inAppNotifications             InAppNotification[]
  communicationPreferenceRecords CustomerCommunicationPreference[]
  campaignMetrics                CampaignMetric[]
  marketingEvents                MarketingEventReceipt[]
  reportDefinitions              ReportDefinition[]
  reportExecutions               ReportExecution[]
  reportArtifacts                ReportArtifact[]
  aiInsightRequests              AiInsightRequest[]
  games                          GameConfiguration[]
  gamePrizes                     GamePrize[]
  gamePlays                      GamePlay[]
  visits                         CustomerVisit[]
  referrals                      CustomerReferral[]
  countries                      PlatformCountry[]
  regions                        PlatformRegion[]
  regionAdministrators           RegionAdministrator[]

  @@index([status])
  @@map("tenants")
}

model PlatformCountry {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  code            String           @db.Char(2)
  name            String
  defaultLocale   String           @default("en") @map("default_locale")
  defaultCurrency String           @default("USD") @map("default_currency") @db.Char(3)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(3)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regions         PlatformRegion[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("platform_countries")
}

model PlatformRegion {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  countryId       String                @map("country_id") @db.Uuid
  code            String
  name            String
  timezone        String
  locale          String
  currency        String                @db.Char(3)
  status          RegionStatus          @default(ACTIVE)
  culturalProfile Json                  @default("{}") @map("cultural_profile")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?             @map("archived_at") @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country         PlatformCountry       @relation(fields: [countryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  administrators  RegionAdministrator[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, countryId, status])
  @@map("platform_regions")
}

model RegionAdministrator {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  regionId   String         @map("region_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  assignedAt DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(3)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  region     PlatformRegion @relation(fields: [regionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, regionId, userId])
  @@index([tenantId, userId])
  @@map("region_administrators")
}

model Organization {
  id                    String                        @id @default(uuid()) @db.Uuid
  tenantId              String                        @map("tenant_id") @db.Uuid
  code                  String
  legalName             String                        @map("legal_name")
  displayName           String                        @map("display_name")
  registrationNumber    String?                       @map("registration_number")
  taxIdentifier         String?                       @map("tax_identifier")
  countryCode           String                        @map("country_code") @db.Char(2)
  timezone              String
  status                OrganizationStatus            @default(DRAFT)
  settings              Json                          @default("{}")
  activatedAt           DateTime?                     @map("activated_at") @db.Timestamptz(3)
  suspendedAt           DateTime?                     @map("suspended_at") @db.Timestamptz(3)
  archivedAt            DateTime?                     @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  franchises            Franchise[]
  merchants             Merchant[]
  branches              Branch[]
  memberships           Membership[]
  staff                 Staff[]
  customers             Customer[]
  loyaltyPrograms       LoyaltyProgram[]
  rewardCategories      RewardCategory[]
  rewards               Reward[]
  pointsEntries         PointsLedgerEntry[]
  rewardRedemptions     RewardRedemption[]
  xpRules               XpRule[]
  gamificationProfiles  CustomerGamificationProfile[]
  xpEntries             XpLedgerEntry[]
  games                 GameConfiguration[]
  visits                CustomerVisit[]
  referrals             CustomerReferral[]
  challenges            Challenge[]
  habits                Habit[]
  streakRules           StreakRule[]
  badgeCategories       BadgeCategory[]
  badges                Badge[]
  customerSegments      CustomerSegment[]
  campaigns             Campaign[]
  automationWorkflows   AutomationWorkflow[]
  notificationTemplates NotificationTemplate[]
  reportDefinitions     ReportDefinition[]
  aiInsightRequests     AiInsightRequest[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("organizations")
}

model Franchise {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  status         FranchiseStatus @default(ACTIVE)
  settings       Json            @default("{}")
  archivedAt     DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  merchants      Merchant[]
  branches       Branch[]
  staff          Staff[]

  @@unique([id, tenantId])
  @@unique([id, organizationId, tenantId])
  @@unique([tenantId, code])
  @@index([organizationId, tenantId])
  @@index([tenantId, status])
  @@map("franchises")
}

model Merchant {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  franchiseId       String?             @map("franchise_id") @db.Uuid
  code              String
  legalName         String              @map("legal_name")
  displayName       String              @map("display_name")
  status            MerchantStatus      @default(DRAFT)
  contactEmail      String?             @map("contact_email")
  contactPhone      String?             @map("contact_phone")
  website           String?
  addressLine       String?             @map("address_line")
  city              String?
  countryCode       String?             @map("country_code") @db.Char(2)
  timezone          String?
  locale            String?
  settings          Json                @default("{}")
  activatedAt       DateTime?           @map("activated_at") @db.Timestamptz(3)
  suspendedAt       DateTime?           @map("suspended_at") @db.Timestamptz(3)
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization      Organization        @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  franchise         Franchise?          @relation(fields: [franchiseId, organizationId, tenantId], references: [id, organizationId, tenantId], onDelete: Restrict)
  branches          Branch[]
  staff             Staff[]
  programMerchants  ProgramMerchant[]
  pointsEntries     PointsLedgerEntry[]
  rewardMerchants   RewardMerchant[]
  rewardRedemptions RewardRedemption[]
  qrTransactions    QrTransaction[]
  visits            CustomerVisit[]

  @@unique([id, tenantId])
  @@unique([id, organizationId, tenantId])
  @@unique([tenantId, code])
  @@index([organizationId, tenantId])
  @@index([franchiseId, tenantId])
  @@index([tenantId, status])
  @@map("merchants")
}

model Branch {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  merchantId        String              @map("merchant_id") @db.Uuid
  franchiseId       String?             @map("franchise_id") @db.Uuid
  code              String
  name              String
  addressLine       String?             @map("address_line")
  addressLine2      String?             @map("address_line_2")
  city              String?
  region            String?
  postalCode        String?             @map("postal_code")
  countryCode       String              @map("country_code") @db.Char(2)
  timezone          String
  locale            String              @default("en")
  currency          String              @db.Char(3)
  phone             String?
  email             String?
  status            BranchStatus        @default(ACTIVE)
  settings          Json                @default("{}")
  openingHours      Json                @default("{}") @map("opening_hours")
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization      Organization        @relation(fields: [organizationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  merchant          Merchant            @relation(fields: [merchantId, organizationId, tenantId], references: [id, organizationId, tenantId], onDelete: Cascade)
  franchise         Franchise?          @relation(fields: [franchiseId, organizationId, tenantId], references: [id, organizationId, tenantId], onDelete: Restrict)
  staff             Staff[]
  programBranches   ProgramBranch[]
  pointsEntries     PointsLedgerEntry[]
  rewardBranches    RewardBranch[]
  rewardRedemptions RewardRedemption[]
