  @@map("outbox_events")
}

model AuthSession {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  sessionTokenHash       String    @unique @map("session_token_hash") @db.Char(64)
  refreshTokenCiphertext String    @map("refresh_token_ciphertext")
  refreshTokenIv         String    @map("refresh_token_iv")
  refreshTokenTag        String    @map("refresh_token_tag")
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(3)
  idleExpiresAt          DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress              String?   @map("ip_address") @db.Inet
  userAgent              String?   @map("user_agent")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, revokedAt])
  @@map("auth_sessions")
}
